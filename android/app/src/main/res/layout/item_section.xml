<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="32dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="4dp" android:paddingEnd="4dp">
    <TextView android:id="@+id/section_label" style="@style/T.Label" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1" android:accessibilityHeading="true" />
    <ProgressBar android:id="@+id/section_spinner" android:layout_width="16dp" android:layout_height="16dp"
        android:indeterminateTint="@color/accent" android:visibility="gone" android:importantForAccessibility="no" />
    <TextView android:id="@+id/section_status" style="@style/T.Cap" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="6dp" android:visibility="gone"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>

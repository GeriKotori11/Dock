<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView stays at the bottom so it survives the switch sheet; native screens
     are inflated into `screens` above it (spec section 12, Android structure). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <WebView android:id="@+id/web" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="invisible" />
    <FrameLayout android:id="@+id/screens" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@color/bg"
        android:clickable="true" android:focusable="false" />
</FrameLayout>

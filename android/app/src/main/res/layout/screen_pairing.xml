<?xml version="1.0" encoding="utf-8"?>
<!-- S5 / S6 Pairing (mockups 11, 13, 14). Two columns for step 1 and the closed
     state; a compact top-bar layout for the PIN while the number pad is up. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/pair_columns" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="60dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="250dp" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:id="@+id/pair_ident" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:focusable="true">
                <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_glyph">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                        android:src="@drawable/ic_monitor" android:tint="@color/text_2" android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:id="@+id/pair_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text"
                        android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/pair_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/text_2" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/pair_step1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:focusable="true">
                <FrameLayout android:id="@+id/pair_step1_ring" android:layout_width="26dp" android:layout_height="26dp"
                    android:background="@drawable/bg_step_now">
                    <TextView android:id="@+id/pair_step1_num" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:text="1" android:textSize="13sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent" />
                    <ImageView android:id="@+id/pair_step1_check" android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_gravity="center" android:src="@drawable/ic_check" android:tint="@color/accent"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView android:id="@+id/pair_step1_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="@string/pair_step1" android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" android:textColor="@color/text" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pair_step2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical" android:focusable="true">
                <TextView android:id="@+id/pair_step2_num" android:layout_width="26dp" android:layout_height="26dp"
                    android:background="@drawable/bg_step_idle" android:gravity="center" android:text="2"
                    android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_3" />
                <TextView android:id="@+id/pair_step2_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="@string/pair_step2" android:textSize="15sp"
                    android:textColor="@color/text_3" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/pair_right" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="40dp">
            <!-- Step 1: the security code. -->
            <LinearLayout android:id="@+id/pair_code_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pair_code_label" />
                <TextView android:id="@+id/pair_code" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:fontFamily="monospace" android:textSize="34sp" android:textStyle="normal"
                    android:letterSpacing="0.04" android:textColor="@color/text" android:singleLine="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="horizontal"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_glyph_sm">
                        <ImageView android:id="@+id/pair_how_icon" android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_terminal" android:tint="@color/text_2"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/pair_how" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:textSize="13sp"
                        android:textColor="@color/text_2" android:lineSpacingMultiplier="1.15" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="horizontal">
                    <Button android:id="@+id/pair_match" style="@style/Btn.Primary" android:layout_width="wrap_content"
                        android:text="@string/pair_match" />
                    <Button android:id="@+id/pair_no_match" style="@style/Btn.Secondary" android:layout_width="wrap_content"
                        android:layout_marginStart="12dp" android:text="@string/pair_no_match" />
                </LinearLayout>
            </LinearLayout>
            <!-- "They don't match". -->
            <LinearLayout android:id="@+id/pair_nomatch_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glyph_lg_danger">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center"
                        android:src="@drawable/ic_shield" android:tint="@color/danger_text" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:id="@+id/pair_nomatch_title" style="@style/T.Title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/pair_no_match_title"
                    android:accessibilityHeading="true" />
                <TextView android:id="@+id/pair_nomatch_body" style="@style/T.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <Button android:id="@+id/pair_nomatch_back" style="@style/Btn.Secondary" android:layout_width="wrap_content"
                    android:layout_marginTop="22dp" android:text="@string/pair_no_match_back" />
            </LinearLayout>
            <!-- Step 2 closed (mockup 14). -->
            <LinearLayout android:id="@+id/pair_closed_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_glyph_lg">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center"
                        android:src="@drawable/ic_clock" android:tint="@color/text_2" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:id="@+id/pair_closed_title" style="@style/T.Title" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp" android:accessibilityHeading="true" />
                <TextView android:id="@+id/pair_closed_body" style="@style/T.Body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <ProgressBar android:id="@+id/pair_closed_spinner" android:layout_width="16dp" android:layout_height="16dp"
                        android:indeterminateTint="@color/accent" android:layout_marginEnd="8dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/pair_closed_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/closed_waiting" android:textSize="15sp" android:textColor="@color/text_2"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Step 2 PIN entry: compact layout above the number pad (mockup 13). -->
    <LinearLayout android:id="@+id/pair_pin_panel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="60dp" android:visibility="gone">
        <FrameLayout android:id="@+id/pin_field" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:focusable="true" android:clickable="true"
            android:importantForAccessibility="yes" android:contentDescription="@string/pin_label">
            <LinearLayout android:id="@+id/pin_boxes" android:layout_width="wrap_content" android:layout_height="56dp"
                android:orientation="horizontal" android:importantForAccessibility="noHideDescendants" />
            <!-- One real field drawn as six boxes. -->
            <EditText android:id="@+id/pin_input" android:layout_width="1dp" android:layout_height="1dp"
                android:alpha="0" android:background="@null" android:inputType="number" android:maxLength="6"
                android:imeOptions="actionDone|flagNoExtractUi" android:importantForAutofill="no"
                android:cursorVisible="false" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp">
            <ProgressBar android:id="@+id/pin_spinner" android:layout_width="16dp" android:layout_height="16dp"
                android:indeterminateTint="@color/accent" android:layout_marginEnd="8dp" android:visibility="gone"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/pin_icon" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginEnd="8dp" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/pin_message" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/text_3" android:accessibilityLiveRegion="assertive" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/pair_topbar" android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
        <ImageButton android:id="@+id/pair_back" style="@style/IconBtn" android:layout_marginStart="-12dp"
            android:src="@drawable/ic_back" android:tint="@color/text_2" android:contentDescription="@string/pair_close_label" />
        <TextView android:id="@+id/pair_topbar_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="16dp" android:textSize="17sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/text" android:singleLine="true"
            android:ellipsize="end" android:accessibilityHeading="true" android:text="@string/pair_title" />
        <TextView android:id="@+id/pair_topbar_step" style="@style/T.Cap" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

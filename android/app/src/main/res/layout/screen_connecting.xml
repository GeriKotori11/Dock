<?xml version="1.0" encoding="utf-8"?>
<!-- S1 Connecting (mockups 01, 02). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/connecting_content" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:layout_marginBottom="24dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/brand_mark" android:importantForAccessibility="no" />
        <TextView android:id="@+id/connecting_title" style="@style/T.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center"
            android:accessibilityHeading="true" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ProgressBar android:id="@+id/connecting_spinner" android:layout_width="16dp"
                android:layout_height="16dp" android:indeterminateTint="@color/accent"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/connecting_check" android:layout_width="16dp"
                android:layout_height="16dp" android:src="@drawable/ic_check"
                android:tint="@color/accent" android:visibility="gone"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/connecting_status" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textSize="15sp" android:textColor="@color/text_2"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/connecting_other" style="@style/Btn.Ghost"
        android:layout_width="wrap_content" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp" android:text="@string/connecting_other" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:background="@drawable/bg_card"
    android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
    android:paddingTop="16dp" android:paddingBottom="16dp" android:focusable="true">
    <TextView android:id="@+id/code_card_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/text_3" />
    <TextView android:id="@+id/code_card_code" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:fontFamily="monospace" android:textSize="19sp" android:letterSpacing="0.04"
        android:singleLine="true" />
</LinearLayout>

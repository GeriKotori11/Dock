<?xml version="1.0" encoding="utf-8"?>
<!-- Q5 / Q6 / Q7 confirmation and pairing, Q8 code already used, Q9 pairing closed
     (docs/design/HOST-CONTROL-PAGE.md 10.5 to 10.7; mockups qr-06, qr-08, qr-09). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/qr_columns" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="60dp" android:paddingBottom="24dp">
        <LinearLayout android:id="@+id/qr_left" android:layout_width="@dimen/split_left"
            android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:id="@+id/qr_glyph" android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/bg_glyph_lg_accent" android:importantForAccessibility="no">
                <ImageView android:id="@+id/qr_icon" android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_gravity="center" android:src="@drawable/ic_monitor" android:tint="@color/accent" />
            </FrameLayout>
            <TextView android:id="@+id/qr_title" style="@style/T.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:accessibilityHeading="true" android:focusable="true" />
            <TextView android:id="@+id/qr_body" style="@style/T.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <LinearLayout android:id="@+id/qr_status_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone">
                <ProgressBar android:id="@+id/qr_status_spinner" android:layout_width="16dp" android:layout_height="16dp"
                    android:indeterminateTint="@color/accent" android:layout_marginEnd="8dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/qr_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/closed_waiting" android:textSize="15sp" android:textColor="@color/text_2"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="40dp">
            <!-- Q5 / Q6 / Q7 -->
            <LinearLayout android:id="@+id/qr_confirm_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_card" android:orientation="vertical" android:paddingStart="16dp">
                    <LinearLayout android:id="@+id/qr_address_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp"
                        android:paddingEnd="16dp" android:focusable="true">
                        <TextView android:layout_width="108dp" android:layout_height="wrap_content"
                            android:text="@string/confirm_address" android:textSize="13sp" android:textColor="@color/text_2" />
                        <TextView android:id="@+id/qr_address" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:fontFamily="monospace" android:textSize="15sp"
                            android:textColor="@color/text" android:singleLine="true" android:ellipsize="end" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                    <LinearLayout android:id="@+id/qr_code_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp"
                        android:paddingEnd="16dp" android:focusable="true">
                        <TextView android:layout_width="108dp" android:layout_height="wrap_content"
                            android:text="@string/confirm_code" android:textSize="13sp" android:textColor="@color/text_2" />
                        <TextView android:id="@+id/qr_code" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:fontFamily="monospace" android:textSize="15sp"
                            android:textColor="@color/text" android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="1dp"
                        android:src="@drawable/ic_shield" android:tint="@color/text_3" android:importantForAccessibility="no" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="10dp" android:text="@string/confirm_caveat"
                        android:textSize="13sp" android:textColor="@color/text_3" android:lineSpacingMultiplier="1.15" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qr_buttons" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/qr_pair" android:layout_width="wrap_content" android:layout_height="48dp"
                        android:minWidth="150dp" android:background="@drawable/bg_button_primary" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                        android:clickable="true" android:focusable="true">
                        <ProgressBar android:id="@+id/qr_pair_spinner" android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_marginEnd="8dp" android:indeterminateTint="@color/on_accent" android:visibility="gone"
                            android:importantForAccessibility="no" />
                        <TextView android:id="@+id/qr_pair_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/confirm_pair" android:textSize="15sp" android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_accent" />
                    </LinearLayout>
                    <Button android:id="@+id/qr_cancel" style="@style/Btn.Secondary" android:layout_width="wrap_content"
                        android:layout_marginStart="12dp" android:text="@string/cancel" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qr_done" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center_vertical"
                    android:visibility="gone" android:accessibilityLiveRegion="polite">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_check"
                        android:tint="@color/accent" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="@string/confirm_paired" android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/accent" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qr_message_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:visibility="gone">
                    <ImageView android:id="@+id/qr_message_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/qr_message" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="13sp"
                        android:textColor="@color/danger_text" android:accessibilityLiveRegion="assertive" />
                </LinearLayout>
            </LinearLayout>

            <!-- Q8 -->
            <LinearLayout android:id="@+id/qr_used_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_card" android:orientation="horizontal"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_glyph_sm_accent">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                            android:src="@drawable/ic_monitor" android:tint="@color/accent" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/qr_used_where" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:textSize="13sp"
                        android:textColor="@color/text_2" android:lineSpacingMultiplier="1.15" />
                </LinearLayout>
                <LinearLayout android:id="@+id/qr_used_camera" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="16dp" android:background="@drawable/bg_button_primary" android:orientation="horizontal"
                    android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_camera" android:tint="@color/on_accent" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cam_sheet_open" android:textSize="15sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/on_accent" />
                </LinearLayout>
                <Button android:id="@+id/qr_used_pin" style="@style/Btn.Secondary" android:layout_width="match_parent"
                    android:layout_marginTop="12dp" android:text="@string/scanner_pin_instead" />
            </LinearLayout>

            <!-- Q9 -->
            <LinearLayout android:id="@+id/qr_closed_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp"
                android:visibility="gone">
                <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_glyph_sm_accent">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                        android:src="@drawable/ic_info" android:tint="@color/accent" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:text="@string/closed_qr_note" android:textSize="13sp"
                    android:textColor="@color/text_2" android:lineSpacingMultiplier="1.15" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
        <ImageButton android:id="@+id/qr_back" style="@style/IconBtn" android:layout_marginStart="-12dp"
            android:src="@drawable/ic_back" android:tint="@color/text_2" android:contentDescription="@string/cancel" />
    </LinearLayout>
</FrameLayout>

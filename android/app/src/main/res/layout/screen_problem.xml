<?xml version="1.0" encoding="utf-8"?>
<!-- S8 Can't reach, S9 No Wi-Fi, S10 Security code changed (mockups 16, 17, 18). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="32dp" android:paddingBottom="16dp">
    <LinearLayout android:id="@+id/problem_left" android:layout_width="@dimen/split_left"
        android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:id="@+id/problem_glyph" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/bg_glyph_lg" android:importantForAccessibility="no">
            <ImageView android:id="@+id/problem_icon" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_gravity="center" android:tint="@color/text_2" />
        </FrameLayout>
        <TextView android:id="@+id/problem_title" style="@style/T.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp" android:accessibilityHeading="true"
            android:focusable="true" />
        <TextView android:id="@+id/problem_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="@color/text_2"
            android:lineSpacingMultiplier="1.2" />
        <LinearLayout android:id="@+id/problem_status_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ProgressBar android:id="@+id/problem_spinner" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginEnd="8dp" android:indeterminateTint="@color/accent" android:importantForAccessibility="no" />
            <TextView android:id="@+id/problem_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="@color/text_3" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <Space android:id="@+id/problem_spacer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/problem_buttons" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/problem_primary" style="@style/Btn.Primary" android:layout_width="wrap_content" />
            <Button android:id="@+id/problem_secondary" style="@style/Btn.Secondary" android:layout_width="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/problem_usb" style="@style/RailLink" android:layout_width="wrap_content"
            android:layout_marginStart="-12dp" android:layout_marginTop="4dp" android:visibility="gone">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_usb" android:tint="@color/accent" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/wifi_usb"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="40dp" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:id="@+id/problem_right" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
